# Django Core Settings
SECRET_KEY=django-insecure-replace-this-with-a-random-string-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-production-domain.com

# Database Configuration
# For production, use DATABASE_URL=postgres://user:password@host:port/dbname
# If not set, the application will default to local sqlite3
# DATABASE_URL=postgres://db_user:db_password@localhost:5432/turf_db

# CORS Configuration
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend-domain.com

# Production Security (Hardening)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
# SECURE_BROWSER_XSS_FILTER=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
